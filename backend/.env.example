# ── Storage ─────────────────────────────────────────────
# SQLite works out of the box. For Postgres use: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./data/studio.db
DATA_DIR=./data

# ── Providers ───────────────────────────────────────────
# TEXT  (story analysis + scene planning): auto | gemini | heuristic
# IMAGE (character/scene art):             auto | gemini | huggingface | deepinfra | together | pollinations | mock
# VOICE (narration + character voices):    auto | elevenlabs | edgetts | espeak | tone
# "auto" picks the best provider you have a key for, otherwise a free/offline one.
TEXT_PROVIDER=auto
IMAGE_PROVIDER=auto
VOICE_PROVIDER=auto

GEMINI_API_KEY=
HF_API_KEY=
DEEPINFRA_API_KEY=
TOGETHER_API_KEY=
ELEVENLABS_API_KEY=

# ── Video ───────────────────────────────────────────────
DEFAULT_ASPECT_RATIO=9:16
# Parallel image jobs. Keep low on free-tier image APIs (rate limits).
IMAGE_CONCURRENCY=2
MAX_ATTEMPTS=3

# ── Web ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
