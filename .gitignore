# ==========================================
# 🤫 Security & Environment Variables (CRITICAL)
# ==========================================
.env
.env.local
.env.*.local
# Do NOT ignore .env.example as it serves as a template for other devs
!.env.example

# ==========================================
# 🪵 Local Logs & Telemetry
# ==========================================
# Ignores the local folder mapped via Docker volumes for pipeline logs
logs/
*.log

# ==========================================
# 🎬 Temporary Media & Render Cache
# ==========================================
# If you ever download or render media clips directly into your local workspace 
# instead of the container's /tmp directory, this keeps them out of your repo.
*.mp4
*.mp3
*.wav
*.png
*.jpg
*.jpeg
clips.txt

# ==========================================
# 🐍 Python Environment & Bytecode
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/

# ==========================================
# 🐳 Docker & Local Database Storage
# ==========================================
# If you map your PostgreSQL data to a local directory for persistence
postgres_data/
pgdata/

# ==========================================
# 💻 IDEs, Editors & OS Specific Files
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db